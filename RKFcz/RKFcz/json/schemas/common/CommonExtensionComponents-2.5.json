{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonExtensionComponents-2",
  "description": "UBL 2.5 Common Extension Components",
  "$defs": {
    "UBLExtensionsType": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UBLExtensionType"
      },
      "minItems": 1
    },
    "UBLExtensionType": {
      "type": "object",
      "description": "A single extension for private use.",
      "properties": {
        "ID": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonBasicComponents-2#/$defs/ID"
        },
        "Name": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonBasicComponents-2#/$defs/Name"
        },
        "ExtensionAgencyID": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonBasicComponents-2#/$defs/ExtensionAgencyID"
        },
        "ExtensionAgencyName": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonBasicComponents-2#/$defs/ExtensionAgencyName"
        },
        "ExtensionVersionID": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonBasicComponents-2#/$defs/ExtensionVersionID"
        },
        "ExtensionAgencyURI": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonBasicComponents-2#/$defs/ExtensionAgencyURI"
        },
        "ExtensionURI": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonBasicComponents-2#/$defs/ExtensionURI"
        },
        "ExtensionReasonCode": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonBasicComponents-2#/$defs/ExtensionReasonCode"
        },
        "ExtensionReason": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/CommonBasicComponents-2#/$defs/ExtensionReason"
        },
        "ExtensionContent": {
          "$ref": "https://docs.oasis-open.org/ubl/2/json/schemas/UnqualifiedDataTypes-2#/$defs/ContentType"
        },
        "UBLEntity": {
          "type": "string",
          "minLength": 1,
          "description": "Identifies the schema governing this extension content."
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "title": "UBL Extension. Details",
      "required": [
        "ExtensionContent",
        "UBLEntity",
        "ExtensionURI"
      ]
    }
  }
}
